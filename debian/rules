#!/usr/bin/make -f
# The Rust side is std only. build.rs also compiles the Qt dialog.
# There is no debhelper Cargo buildsystem here, so the release binary
# and screenmirror-about are built with the locked lockfile and installed
# by debian/screenmirror.install.

# Commit shown as Git-ID. A tree without git falls back to the changelog version,
# then to the same placeholder the About window uses.
git_id := $(shell git rev-parse HEAD 2>/dev/null)
ifeq ($(strip $(git_id)),)
git_id := $(shell sed -n 's/^screenmirror (\([^)]*\)).*/\1/p' debian/changelog | head -n 1)
endif
ifeq ($(strip $(git_id)),)
git_id := unbekannt
endif
export SCREENMIRROR_GIT_ID := $(git_id)

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	cargo build --locked --release

override_dh_auto_test:
	cargo test --locked

override_dh_auto_clean:
	cargo clean

override_dh_dwz:
	# cargo --release emits no DWARF, so dwz has nothing to compress.
	:
